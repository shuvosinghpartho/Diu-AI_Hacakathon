#!/bin/bash

echo "🚀 Starting VisionPay Terminal backend..."

# Check if already running
if [ -f .app_pid ]; then
    PID=$(cat .app_pid)
    if ps -p $PID > /dev/null; then
        echo "⚠️ App is already running! (PID: $PID)"
        echo "👉 Run ./stop to stop it first."
        exit 1
    else
        # Stale PID file
        rm .app_pid
    fi
fi

# Activate virtual environment if exists
if [ -d "venv" ]; then
    source venv/bin/activate
else
    echo "⚠️ Warning: venv not found. Ensure requirements are installed globally or create a venv."
fi

# Start uvicorn in background and save logs
echo "Spinning up FastAPI server..."
nohup uvicorn backend.app:app --host 127.0.0.1 --port 8000 > app.log 2>&1 &
PID=$!

# Save PID
echo $PID > .app_pid

echo ""
echo "✅ Backend is running in the background (PID: $PID)."
echo "🌐 Open http://127.0.0.1:8000 in your browser."
echo "📝 Server logs are being saved to app.log"
echo "🛑 To stop the server, run: ./stop"
